VITE_FIREBASE_API_KEY=replace_with_your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=replace_with_your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace_with_your_project_id
VITE_FIREBASE_STORAGE_BUCKET=replace_with_your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace_with_your_sender_id
VITE_FIREBASE_APP_ID=replace_with_your_app_id
# Clé publique reCAPTCHA Enterprise utilisée par Firebase App Check en production.
VITE_FIREBASE_APP_CHECK_SITE_KEY=replace_with_your_recaptcha_enterprise_site_key
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
VITE_FIREBASE_STORAGE_EMULATOR_PORT=9199

# Passerelle serveur Cartularia. Ne configurez jamais directement l’URL ou un
# secret d’autorité de temps dans VITE_* : le navigateur ne doit envoyer que la
# racine Merkle à une passerelle contrôlée par Cartularia.
VITE_CARTULARIA_TIMESTAMP_URL=/api/timestamps
# Variables serveur de la passerelle RFC 3161 (le serveur Vite local les lit).
CARTULARIA_TSA_URL=http://timestamp.digicert.com
CARTULARIA_TSA_PROVIDER=DigiCert RFC 3161 TSA
CARTULARIA_TSA_TIMEOUT_MS=20000
