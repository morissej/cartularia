# Projet Firebase exclusivement dédié au Coffre personnel.
# Ces valeurs ne doivent jamais désigner studio-2614005370-a3e51.
VITE_PERSONAL_FIREBASE_API_KEY=
VITE_PERSONAL_FIREBASE_AUTH_DOMAIN=
VITE_PERSONAL_FIREBASE_PROJECT_ID=
VITE_PERSONAL_FIREBASE_STORAGE_BUCKET=
VITE_PERSONAL_FIREBASE_MESSAGING_SENDER_ID=
VITE_PERSONAL_FIREBASE_APP_ID=

# Garde-fou de séparation. Le build échoue à l’exécution si les deux IDs coïncident.
VITE_REGISTRY_FIREBASE_PROJECT_ID=studio-2614005370-a3e51
VITE_PERSONAL_USE_FIREBASE_EMULATORS=false
VITE_PERSONAL_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_PERSONAL_AUTH_EMULATOR_PORT=19299
VITE_PERSONAL_FIRESTORE_EMULATOR_PORT=8280

# Troisième projet Firebase : uniquement les codes de correspondance.
# Il doit être distinct à la fois du Registre et du Coffre personnel.
VITE_CODE_BRIDGE_FIREBASE_API_KEY=
VITE_CODE_BRIDGE_FIREBASE_AUTH_DOMAIN=
VITE_CODE_BRIDGE_FIREBASE_PROJECT_ID=
VITE_CODE_BRIDGE_FIREBASE_STORAGE_BUCKET=
VITE_CODE_BRIDGE_FIREBASE_MESSAGING_SENDER_ID=
VITE_CODE_BRIDGE_FIREBASE_APP_ID=
# En local, un même processus d’émulation peut servir plusieurs IDs projet.
VITE_CODE_BRIDGE_AUTH_EMULATOR_PORT=19299
VITE_CODE_BRIDGE_FIRESTORE_EMULATOR_PORT=8280
