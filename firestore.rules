rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function accountIsActive(uid) {
      return signedIn()
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.status == 'active';
    }

    function membershipPath(organizationId) {
      return /databases/$(database)/documents/organizations/$(organizationId)/memberships/$(request.auth.uid);
    }

    function hasActiveMembership(organizationId) {
      return signedIn()
        && exists(membershipPath(organizationId))
        && get(membershipPath(organizationId)).data.status == 'active'
        && get(membershipPath(organizationId)).data.uid == request.auth.uid;
    }

    function hasPermission(organizationId, permission) {
      return hasActiveMembership(organizationId)
        && permission in get(membershipPath(organizationId)).data.permissions;
    }

    function registryIsInScope(organizationId, registryId) {
      return hasActiveMembership(organizationId)
        && registryId in get(membershipPath(organizationId)).data.scopes.registryIds;
    }

    function canReadRegistry(organizationId, registryId) {
      return hasPermission(organizationId, 'registry.read')
        && registryIsInScope(organizationId, registryId);
    }

    function membershipIsInvitationManaged(organizationId) {
      return hasActiveMembership(organizationId)
        && get(membershipPath(organizationId)).data.get('invitationManaged', false) == true;
    }

    function invitationGrant(organizationId, registryId) {
      return get(membershipPath(organizationId)).data.get('invitationGrants', {}).get(
        registryId,
        { 'registry': false, 'collectionIds': [], 'cartularyIds': [] }
      );
    }

    function canReadRegistryItem(organizationId, registryId, cartularyId, collectionId, collectionIds) {
      return canReadRegistry(organizationId, registryId)
        && (
          !membershipIsInvitationManaged(organizationId)
          || invitationGrant(organizationId, registryId).registry == true
          || cartularyId in invitationGrant(organizationId, registryId).cartularyIds
          || collectionId in invitationGrant(organizationId, registryId).collectionIds
          || (collectionIds is list && collectionIds.hasAny(invitationGrant(organizationId, registryId).collectionIds))
        );
    }

    function canReadRegistryCollection(organizationId, registryId, collectionId) {
      return canReadRegistry(organizationId, registryId)
        && (
          !membershipIsInvitationManaged(organizationId)
          || invitationGrant(organizationId, registryId).registry == true
          || collectionId in invitationGrant(organizationId, registryId).collectionIds
        );
    }

    function canReadCartulary(organizationId, registryId, cartularyId) {
      return hasPermission(organizationId, 'cartulary.read')
        && registryIsInScope(organizationId, registryId)
        && (
          !membershipIsInvitationManaged(organizationId)
          || invitationGrant(organizationId, registryId).registry == true
          || cartularyId in invitationGrant(organizationId, registryId).cartularyIds
        );
    }

    function canManageRegistry(organizationId, registryId) {
      return hasPermission(organizationId, 'cartulary.edit')
        && registryIsInScope(organizationId, registryId);
    }

    function isLegalOwnerInScope(organizationId, registryId, permission) {
      return hasPermission(organizationId, permission)
        && 'legal_owner' in get(membershipPath(organizationId)).data.roles
        && registryIsInScope(organizationId, registryId);
    }

    function communityMembershipPath() {
      return /databases/$(database)/documents/communityMemberships/$(request.auth.uid);
    }

    function hasCommunityPermission(permission) {
      return signedIn()
        && exists(communityMembershipPath())
        && get(communityMembershipPath()).data.uid == request.auth.uid
        && get(communityMembershipPath()).data.status == 'active'
        && permission in get(communityMembershipPath()).data.permissions;
    }

    function communityPublicationIsActive(publicationId) {
      return exists(/databases/$(database)/documents/communityPublications/$(publicationId))
        && get(/databases/$(database)/documents/communityPublications/$(publicationId)).data.status == 'published'
        && get(/databases/$(database)/documents/communityPublications/$(publicationId)).data.moderationStatus == 'approved';
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn()
        && request.auth.uid == uid
        && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt', 'updatedAt'])
        && request.resource.data.lastActiveAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow list, create, delete: if false;

      match /private/{privateDocument} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list, create, update, delete: if false;
      }
    }

    match /organizations/{organizationId} {
      allow get: if hasPermission(organizationId, 'organization.read');
      allow list, create, update, delete: if false;

      match /memberships/{uid} {
        allow get: if signedIn()
          && (request.auth.uid == uid || hasPermission(organizationId, 'membership.read'));
        allow list: if hasPermission(organizationId, 'membership.read');
        allow create, update, delete: if false;
      }
    }

    // Autorise uniquement une requête collectionGroup explicitement bornée au uid courant.
    match /{membershipPath=**}/memberships/{membershipId} {
      allow get, list: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /registries/{registryId} {
      allow get: if canReadRegistry(resource.data.organizationId, registryId);
      allow list, create, update, delete: if false;

      match /items/{cartularyId} {
        allow get, list: if canReadRegistryItem(
          get(/databases/$(database)/documents/registries/$(registryId)).data.organizationId,
          registryId,
          cartularyId,
          resource.data.collectionId,
          resource.data.get('collectionIds', [])
        );
        allow create, update, delete: if false;
      }

      match /collections/{collectionId} {
        allow get, list: if canReadRegistryCollection(
          get(/databases/$(database)/documents/registries/$(registryId)).data.organizationId,
          registryId,
          collectionId
        );
        allow create: if canManageRegistry(
            get(/databases/$(database)/documents/registries/$(registryId)).data.organizationId,
            registryId
          )
          && request.resource.data.id == collectionId
          && request.resource.data.registryId == registryId
          && request.resource.data.organizationId == get(/databases/$(database)/documents/registries/$(registryId)).data.organizationId
          && request.resource.data.name is string
          && request.resource.data.websiteSlug is string
          && request.resource.data.status in ['draft', 'published', 'archived']
          && request.resource.data.visibility in ['secret', 'public']
          && request.resource.data.get('publicationConsent', false) is bool
          && request.resource.data.get('publishedCartularyIds', []) is list
          && request.resource.data.get('publishedCartularyIds', []).size() <= 200
          && (
            request.resource.data.get('publicationConsent', false) == true
              ? request.resource.data.status == 'published'
                && request.resource.data.visibility == 'public'
                && request.resource.data.get('publishedCartularyIds', []).size() > 0
              : request.resource.data.status in ['draft', 'archived'] && request.resource.data.visibility == 'secret'
          );
        allow update: if canManageRegistry(resource.data.organizationId, registryId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.registryId == resource.data.registryId
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'description', 'websiteTitle', 'websiteSlug', 'status', 'visibility',
            'publicationConsent', 'publishedCartularyIds', 'publishedAt', 'updatedAt'
          ])
          && request.resource.data.get('publicationConsent', false) is bool
          && request.resource.data.get('publishedCartularyIds', []) is list
          && request.resource.data.get('publishedCartularyIds', []).size() <= 200
          && (
            request.resource.data.get('publicationConsent', false) == true
              ? request.resource.data.status == 'published'
                && request.resource.data.visibility == 'public'
                && request.resource.data.get('publishedCartularyIds', []).size() > 0
              : request.resource.data.status in ['draft', 'archived'] && request.resource.data.visibility == 'secret'
          );
        allow delete: if canManageRegistry(resource.data.organizationId, registryId);
      }

      match /accesses/{accessId} {
        allow get, list: if canReadRegistry(
          get(/databases/$(database)/documents/registries/$(registryId)).data.organizationId,
          registryId
        ) && hasPermission(
          get(/databases/$(database)/documents/registries/$(registryId)).data.organizationId,
          'access.read'
        );
        allow create, update, delete: if false;
      }
    }

    // Projection publique minimale d’un mini-site de Collection. Elle ne contient
    // ni données privées du Registre, ni documents, ni originaux des Cartulaires.
    match /collectionPublications/{publicationId} {
      function privateCollectionAfter(data) {
        return getAfter(
          /databases/$(database)/documents/registries/$(data.registryId)/collections/$(data.collectionId)
        );
      }

      function publicationMatchesPrivateCollection(data) {
        return existsAfter(
            /databases/$(database)/documents/registries/$(data.registryId)/collections/$(data.collectionId)
          )
          && privateCollectionAfter(data).data.organizationId == data.organizationId
          && privateCollectionAfter(data).data.registryId == data.registryId
          && privateCollectionAfter(data).data.id == data.collectionId
          && data.itemCount == privateCollectionAfter(data).data.get('publishedCartularyIds', []).size()
          && (
            data.status == 'published'
              ? privateCollectionAfter(data).data.get('publicationConsent', false) == true
                && privateCollectionAfter(data).data.status == 'published'
                && privateCollectionAfter(data).data.visibility == 'public'
              : privateCollectionAfter(data).data.get('publicationConsent', false) == false
                && privateCollectionAfter(data).data.status in ['draft', 'archived']
                && privateCollectionAfter(data).data.visibility == 'secret'
          );
      }

      function validCollectionPublication(data) {
        return data.keys().hasOnly([
            'publicationId', 'organizationId', 'registryId', 'collectionId',
            'websiteTitle', 'websiteSlug', 'description', 'status', 'itemCount',
            'publishedAt', 'updatedAt'
          ])
          && data.publicationId == publicationId
          && data.publicationId == data.registryId + '--' + data.collectionId
          && data.organizationId is string
          && data.registryId is string
          && data.collectionId is string
          && data.websiteTitle is string
          && data.websiteTitle.size() <= 160
          && data.websiteSlug is string
          && data.websiteSlug.matches('^[a-z0-9][a-z0-9-]{0,63}$')
          && data.description is string
          && data.description.size() <= 2000
          && data.status in ['published', 'revoked']
          && data.itemCount is int
          && data.itemCount >= 0
          && data.itemCount <= 200
          && publicationMatchesPrivateCollection(data);
      }

      allow get: if resource.data.status == 'published'
        || canManageRegistry(resource.data.organizationId, resource.data.registryId);
      allow list: if false;
      allow create: if validCollectionPublication(request.resource.data)
        && canManageRegistry(request.resource.data.organizationId, request.resource.data.registryId);
      allow update: if validCollectionPublication(request.resource.data)
        && request.resource.data.publicationId == resource.data.publicationId
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.registryId == resource.data.registryId
        && request.resource.data.collectionId == resource.data.collectionId
        && canManageRegistry(resource.data.organizationId, resource.data.registryId);
      allow delete: if canManageRegistry(resource.data.organizationId, resource.data.registryId);

      match /items/{cartularyId} {
        function publication() {
          return get(/databases/$(database)/documents/collectionPublications/$(publicationId));
        }

        function publicationAfter() {
          return getAfter(/databases/$(database)/documents/collectionPublications/$(publicationId));
        }

        function validCollectionPublicationItem(data) {
          return data.keys().hasOnly([
              'cartularyId', 'collectionId', 'assetType', 'displayTitle', 'makerName',
              'modelName', 'referenceCode', 'manufactureYear', 'publicCode'
            ])
            && data.cartularyId == cartularyId
            && data.collectionId == publicationAfter().data.collectionId
            && data.cartularyId in privateCollectionAfter(publicationAfter().data).data.get('publishedCartularyIds', [])
            && data.assetType is string
            && data.displayTitle is string
            && data.makerName is string
            && data.modelName is string
            && (data.referenceCode == null || data.referenceCode is string)
            && (data.manufactureYear == null || data.manufactureYear is int)
            && (data.publicCode == null || data.publicCode is string);
        }

        allow get, list: if publication().data.status == 'published'
          || canManageRegistry(publication().data.organizationId, publication().data.registryId);
        allow create, update: if validCollectionPublicationItem(request.resource.data)
          && canManageRegistry(publicationAfter().data.organizationId, publicationAfter().data.registryId);
        allow delete: if canManageRegistry(publicationAfter().data.organizationId, publicationAfter().data.registryId);
      }
    }

    match /schemaCatalog/{assetType} {
      allow get, list: if signedIn();
      allow create, update, delete: if false;

      match /{schemaDocument=**} {
        allow get, list: if signedIn();
        allow create, update, delete: if false;
      }
    }

    match /cartularies/{cartularyId} {
      allow get: if canReadCartulary(resource.data.organizationId, resource.data.registryId, cartularyId);
      allow list, create, update, delete: if false;

      match /reminders/{reminderId} {
        function cartularyRoot() {
          return get(/databases/$(database)/documents/cartularies/$(cartularyId)).data;
        }

        function validReminderDocument() {
          return request.resource.data.id == reminderId
            && request.resource.data.cartularyId == cartularyId
            && request.resource.data.organizationId == cartularyRoot().organizationId
            && request.resource.data.title is string
            && request.resource.data.title.size() > 0
            && request.resource.data.title.size() <= 200
            && request.resource.data.dueAt is string
            && request.resource.data.category in ['insurance', 'visual_evidence', 'maintenance', 'custom']
            && request.resource.data.reminderStatus in ['planned', 'active', 'completed', 'dismissed']
            && request.resource.data.visibility == 'secret';
        }

        allow create: if canManageRegistry(cartularyRoot().organizationId, cartularyRoot().registryId)
          && request.resource.data.keys().hasOnly([
            'id', 'cartularyId', 'organizationId', 'title', 'dueAt', 'category',
            'reminderStatus', 'visibility', 'source', 'createdBy', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'id', 'cartularyId', 'organizationId', 'title', 'dueAt', 'category',
            'reminderStatus', 'visibility', 'source', 'createdBy', 'createdAt', 'updatedAt'
          ])
          && validReminderDocument()
          && request.resource.data.source in ['cartulary', 'registry']
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if canManageRegistry(cartularyRoot().organizationId, cartularyRoot().registryId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'dueAt', 'category', 'reminderStatus', 'updatedAt'
          ])
          && request.resource.data.id == resource.data.id
          && request.resource.data.cartularyId == resource.data.cartularyId
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.visibility == resource.data.visibility
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.dueAt is string
          && (!('category' in request.resource.data) || request.resource.data.category in ['insurance', 'visual_evidence', 'maintenance', 'custom'])
          && request.resource.data.reminderStatus in ['planned', 'active', 'completed', 'dismissed']
          && request.resource.data.updatedAt == request.time;
        allow delete: if canManageRegistry(cartularyRoot().organizationId, cartularyRoot().registryId);
      }

      match /{cartularyDocument=**} {
        allow get, list: if canReadCartulary(
          get(/databases/$(database)/documents/cartularies/$(cartularyId)).data.organizationId,
          get(/databases/$(database)/documents/cartularies/$(cartularyId)).data.registryId,
          cartularyId
        );
        allow create, update, delete: if false;
      }
    }

    // Documents exclusivement administrés par les Functions d'invitation.
    match /registryInvitations/{invitationId} {
      allow read, write: if false;
    }

    match /mail/{mailId} {
      allow read, write: if false;
    }

    // Copie privée de synchronisation du prototype. Elle appartient au compte,
    // reste séparée du Cartulaire autoritaire et ne peut alimenter aucune publication.
    match /privateDrafts/{uid} {
      function registrySafeStateKey(stateKey) {
        return !(stateKey in [
          'cartularia-owner-fields',
          'cartularia-owner-type',
          'cartularia-owner-documents',
          'cartularia-transmission-recipients',
          'cartularia-storage-locations',
          'cartularia-storage-description'
        ]);
      }

      allow read, write: if false;

      match /cartularies/{cartularyId} {
        allow get, list: if accountIsActive(uid);
        allow create: if accountIsActive(uid)
          && request.resource.data.ownerUid == uid
          && request.resource.data.cartularyId == cartularyId
          && request.resource.data.status == 'active'
          && request.resource.data.retentionPolicyVersion == 'inactive-plus-2y-v1';
        allow update: if accountIsActive(uid)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.ownerUid == uid
          && request.resource.data.cartularyId == resource.data.cartularyId
          && request.resource.data.cartularyId == cartularyId
          && request.resource.data.retentionPolicyVersion == 'inactive-plus-2y-v1'
          && (
            (resource.data.status == 'active' && request.resource.data.status in ['active', 'deleted'])
            || (resource.data.status == 'deleted' && request.resource.data.status == 'deleted')
          );
        allow delete: if signedIn() && request.auth.uid == uid && resource.data.ownerUid == uid;

        match /state/{stateKey} {
          allow get, list: if accountIsActive(uid)
            && get(/databases/$(database)/documents/privateDrafts/$(uid)/cartularies/$(cartularyId)).data.status == 'active';
          allow create, update: if accountIsActive(uid)
            && get(/databases/$(database)/documents/privateDrafts/$(uid)/cartularies/$(cartularyId)).data.status == 'active'
            && request.resource.data.keys().hasOnly([
              'ownerUid', 'cartularyId', 'key', 'value', 'deleted', 'revision',
              'clientUpdatedAt', 'updatedAt'
            ])
            && request.resource.data.ownerUid == uid
            && request.resource.data.cartularyId == cartularyId
            && request.resource.data.key == stateKey
            && registrySafeStateKey(stateKey)
            && stateKey.matches('^cartularia-[A-Za-z0-9:_-]+$')
            && request.resource.data.revision is int
            && request.resource.data.revision > 0
            && request.resource.data.clientUpdatedAt is number
            && request.resource.data.deleted is bool
            && (
              (request.resource.data.deleted == true && request.resource.data.value == null)
              || (
                request.resource.data.deleted == false
                && request.resource.data.value is string
                && request.resource.data.value.size() <= 900000
              )
            );
          allow delete: if signedIn() && request.auth.uid == uid;
        }

        match /binaries/{binaryId} {
          function clientBinaryKeys() {
            return [
              'ownerUid', 'cartularyId', 'binaryId', 'deleted', 'revision', 'fileName',
              'mimeType', 'size', 'sha256', 'kind', 'storagePath', 'clientUpdatedAt',
              'uploadStatus', 'updatedAt'
            ];
          }

          function verifiedBinaryKeys() {
            return [
              'verificationStatus', 'verificationVersion', 'verificationReason',
              'verificationMessage', 'verificationStartedAt', 'detectedMimeType',
              'detectedFormat', 'verifiedSize', 'imageWidth', 'imageHeight',
              'capturedAtExtracted', 'capturedAtSource', 'derivativeStatus',
              'presentationDerivative', 'metadataPolicy', 'malwareScanStatus',
              'mediaDecodeStatus', 'publicationEligible', 'verifiedAt'
            ];
          }

          function validClientBinary() {
            return request.resource.data.ownerUid == uid
              && request.resource.data.cartularyId == cartularyId
              && request.resource.data.binaryId == binaryId
              && request.resource.data.revision is int
              && request.resource.data.revision > 0
              && request.resource.data.clientUpdatedAt is number
              && request.resource.data.size is int
              && request.resource.data.size >= 0
              && request.resource.data.sha256.matches('^sha256:[a-f0-9]{64}$')
              && request.resource.data.kind in ['media', 'condition_attachment']
              && (
                (
                  request.resource.data.deleted == true
                  && request.resource.data.storagePath == null
                  && request.resource.data.uploadStatus == 'deleted'
                )
                || (
                  request.resource.data.deleted == false
                  && request.resource.data.storagePath is string
                  && request.resource.data.uploadStatus in ['pending_upload', 'ready']
                )
              );
          }

          allow get, list: if accountIsActive(uid)
            && get(/databases/$(database)/documents/privateDrafts/$(uid)/cartularies/$(cartularyId)).data.status == 'active';
          allow create: if accountIsActive(uid)
            && get(/databases/$(database)/documents/privateDrafts/$(uid)/cartularies/$(cartularyId)).data.status == 'active'
            && request.resource.data.keys().hasOnly(clientBinaryKeys())
            && validClientBinary();
          allow update: if accountIsActive(uid)
            && get(/databases/$(database)/documents/privateDrafts/$(uid)/cartularies/$(cartularyId)).data.status == 'active'
            && request.resource.data.keys().hasOnly(clientBinaryKeys().concat(verifiedBinaryKeys()))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(clientBinaryKeys())
            && validClientBinary();
          allow delete: if signedIn() && request.auth.uid == uid;
        }
      }
    }

    // File d'intention minimale. Le navigateur ne peut modifier ni le Cartulaire
    // autoritaire ni sa projection : une commande Admin valide et exécute la demande.
    match /cartularySyncRequests/{requestDocumentId} {
      function validPendingSyncRequest() {
        return accountIsActive(request.auth.uid)
          && request.resource.data.keys().hasOnly([
            'requestDocumentId', 'requestId', 'ownerUid', 'cartularyId', 'reason',
            'status', 'requestedAt', 'updatedAt'
          ])
          && request.resource.data.requestDocumentId == requestDocumentId
          && request.resource.data.cartularyId == requestDocumentId
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.requestId is string
          && request.resource.data.requestId.matches('^sync_[a-z0-9_]{16,96}$')
          && request.resource.data.reason in ['private_draft_synchronized', 'manual_retry']
          && request.resource.data.status == 'pending'
          && request.resource.data.requestedAt == request.time
          && request.resource.data.updatedAt == request.time
          && exists(/databases/$(database)/documents/cartularies/$(requestDocumentId))
          && get(/databases/$(database)/documents/cartularies/$(requestDocumentId)).data.accountHolderId == request.auth.uid
          && hasPermission(
            get(/databases/$(database)/documents/cartularies/$(requestDocumentId)).data.organizationId,
            'cartulary.edit'
          )
          && registryIsInScope(
            get(/databases/$(database)/documents/cartularies/$(requestDocumentId)).data.organizationId,
            get(/databases/$(database)/documents/cartularies/$(requestDocumentId)).data.registryId
          );
      }

      allow get: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if validPendingSyncRequest();
      allow update: if validPendingSyncRequest()
        && resource.data.status in ['processed', 'failed']
        && request.resource.data.requestId != resource.data.requestId
        && request.resource.data.requestDocumentId == resource.data.requestDocumentId
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.cartularyId == resource.data.cartularyId;
      allow list, delete: if false;
    }

    // Demande de création bornée : le navigateur ne transmet que les identifiants
    // de contexte. Le profil et les fichiers restent dans son brouillon privé ;
    // une fonction Admin crée ensuite le Cartulaire et sa projection minimale.
    match /cartularyCreateRequests/{requestDocumentId} {
      function validPendingCreateRequest() {
        return accountIsActive(request.auth.uid)
          && request.resource.data.keys().hasOnly([
            'requestDocumentId', 'requestId', 'ownerUid', 'cartularyId',
            'organizationId', 'registryId', 'publicCode', 'status',
            'requestedAt', 'updatedAt'
          ])
          && request.resource.data.requestDocumentId == requestDocumentId
          && request.resource.data.cartularyId == requestDocumentId
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.requestId is string
          && request.resource.data.requestId.matches('^create_[a-f0-9]{28}$')
          && request.resource.data.organizationId is string
          && request.resource.data.registryId is string
          && request.resource.data.publicCode is string
          && request.resource.data.publicCode.matches('^[A-Z0-9-]{6,32}$')
          && request.resource.data.status == 'pending'
          && request.resource.data.requestedAt == request.time
          && request.resource.data.updatedAt == request.time
          && exists(/databases/$(database)/documents/privateDrafts/$(request.auth.uid)/cartularies/$(requestDocumentId))
          && get(/databases/$(database)/documents/privateDrafts/$(request.auth.uid)/cartularies/$(requestDocumentId)).data.status == 'active'
          && get(/databases/$(database)/documents/privateDrafts/$(request.auth.uid)/cartularies/$(requestDocumentId)).data.ownerUid == request.auth.uid
          && exists(/databases/$(database)/documents/registries/$(request.resource.data.registryId))
          && get(/databases/$(database)/documents/registries/$(request.resource.data.registryId)).data.organizationId == request.resource.data.organizationId
          && hasPermission(request.resource.data.organizationId, 'cartulary.edit')
          && registryIsInScope(request.resource.data.organizationId, request.resource.data.registryId);
      }

      allow get: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if validPendingCreateRequest();
      allow update: if validPendingCreateRequest()
        && resource.data.status == 'failed'
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.requestDocumentId == resource.data.requestDocumentId
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.cartularyId == resource.data.cartularyId
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.registryId == resource.data.registryId
        && request.resource.data.publicCode == resource.data.publicCode;
      allow list, delete: if false;
    }

    // File d'horodatage authentifiée. Le navigateur peut uniquement déposer
    // une empreinte et relire sa demande ; la Function seule crée le reçu.
    match /timestampRequests/{requestDocumentId} {
      allow get: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if accountIsActive(request.auth.uid)
        && request.resource.data.keys().hasOnly([
          'requestDocumentId', 'requestId', 'ownerUid', 'cartularyId',
          'digest', 'status', 'requestedAt', 'updatedAt'
        ])
        && request.resource.data.requestDocumentId == requestDocumentId
        && request.resource.data.requestId == requestDocumentId
        && request.resource.data.requestId is string
        && request.resource.data.requestId.matches('^timestamp_[a-f0-9]{32}$')
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.cartularyId is string
        && request.resource.data.cartularyId.matches('^[A-Za-z0-9][A-Za-z0-9_-]{5,127}$')
        && request.resource.data.digest is string
        && request.resource.data.digest.matches('^sha256:[a-f0-9]{64}$')
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/cartularies/$(request.resource.data.cartularyId))
        && get(/databases/$(database)/documents/cartularies/$(request.resource.data.cartularyId)).data.accountHolderId == request.auth.uid
        && isLegalOwnerInScope(
          get(/databases/$(database)/documents/cartularies/$(request.resource.data.cartularyId)).data.organizationId,
          get(/databases/$(database)/documents/cartularies/$(request.resource.data.cartularyId)).data.registryId,
          'integrity.batch'
        );
      allow list, update, delete: if false;
    }

    match /timestampReceipts/{receiptId} {
      allow get: if accountIsActive(request.auth.uid)
        && resource.data.ownerUid == request.auth.uid
        && exists(/databases/$(database)/documents/cartularies/$(resource.data.cartularyId))
        && get(/databases/$(database)/documents/cartularies/$(resource.data.cartularyId)).data.accountHolderId == request.auth.uid
        && resource.data.organizationId == get(
          /databases/$(database)/documents/cartularies/$(resource.data.cartularyId)
        ).data.organizationId
        && resource.data.registryId == get(
          /databases/$(database)/documents/cartularies/$(resource.data.cartularyId)
        ).data.registryId
        && isLegalOwnerInScope(resource.data.organizationId, resource.data.registryId, 'integrity.batch');
      allow list, create, update, delete: if false;
    }

    match /cartularyTransfers/{transferId} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.participantUids;
      allow create, update, delete: if false;
    }

    match /cartularyTransferRequests/{requestDocumentId} {
      allow get: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if accountIsActive(request.auth.uid)
        && request.resource.data.keys().hasOnly([
          'requestDocumentId', 'requestId', 'transferId', 'cartularyId',
          'ownerUid', 'counterpartyUid', 'action', 'expectedRevision',
          'decisionSource', 'expiresAtIso', 'status', 'requestedAt', 'updatedAt'
        ])
        && request.resource.data.requestDocumentId == requestDocumentId
        && request.resource.data.requestId == requestDocumentId
        && request.resource.data.requestId.matches('^transfer_request_[a-f0-9]{24}$')
        && request.resource.data.transferId.matches('^transfer_[a-f0-9]{24}$')
        && request.resource.data.cartularyId is string
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.action in ['propose', 'accept', 'reject']
        && request.resource.data.expectedRevision is int
        && request.resource.data.expectedRevision > 0
        && request.resource.data.decisionSource == 'human_confirmed'
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/cartularies/$(request.resource.data.cartularyId))
        && (
          (
            request.resource.data.action == 'propose'
            && get(/databases/$(database)/documents/cartularies/$(request.resource.data.cartularyId)).data.accountHolderId == request.auth.uid
            && request.resource.data.counterpartyUid is string
            && request.resource.data.counterpartyUid != request.auth.uid
            && request.resource.data.expiresAtIso is string
          )
          || (
            request.resource.data.action in ['accept', 'reject']
            && exists(/databases/$(database)/documents/cartularyTransfers/$(request.resource.data.transferId))
            && get(/databases/$(database)/documents/cartularyTransfers/$(request.resource.data.transferId)).data.cartularyId == request.resource.data.cartularyId
            && get(/databases/$(database)/documents/cartularyTransfers/$(request.resource.data.transferId)).data.buyerUid == request.auth.uid
            && get(/databases/$(database)/documents/cartularyTransfers/$(request.resource.data.transferId)).data.status == 'proposed'
          )
        );
      allow list, update, delete: if false;
    }

    match /transferPrivateArchives/{transferId} {
      allow get: if signedIn() && resource.data.sellerUid == request.auth.uid;
      allow list, create, update, delete: if false;

      match /records/{recordId} {
        allow get, list: if signedIn()
          && get(/databases/$(database)/documents/transferPrivateArchives/$(transferId)).data.sellerUid == request.auth.uid;
        allow create, update, delete: if false;
      }
    }

    match /publications/{publicCode} {
      allow get: if resource.data.status == 'published';
      allow list, create, update, delete: if false;

      match /blocks/{blockId} {
        allow get, list: if get(
          /databases/$(database)/documents/publications/$(publicCode)
        ).data.status == 'published';
        allow create, update, delete: if false;
      }
    }

    match /seals/{publicCode} {
      allow get: if resource.data.status == 'issued';
      allow list, create, update, delete: if false;
    }

    match /communityMemberships/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /communityProfiles/{uid} {
      allow get, list: if hasCommunityPermission('community.read')
        && resource.data.status == 'active'
        && resource.data.visibility == 'community';
      allow create, update, delete: if false;

      match /{privateProfileDocument=**} {
        allow read, write: if false;
      }
    }

    match /communityPublications/{publicationId} {
      allow get, list: if hasCommunityPermission('community.read')
        && resource.data.status == 'published'
        && resource.data.moderationStatus == 'approved';
      allow create, update, delete: if false;

      match /blocks/{blockId} {
        allow get, list: if hasCommunityPermission('community.read')
          && communityPublicationIsActive(publicationId);
        allow create, update, delete: if false;
      }

      match /moderationEvents/{eventId} {
        allow get, list: if hasCommunityPermission('community.moderate');
        allow create, update, delete: if false;
      }

      match /{privateCommunityPublicationDocument=**} {
        allow read, write: if false;
      }
    }

    match /communityPosts/{postId} {
      allow get, list: if hasCommunityPermission('community.read')
        && resource.data.status == 'active'
        && resource.data.moderationStatus == 'visible'
        && communityPublicationIsActive(resource.data.communityPublicationId);
      allow create, update, delete: if false;

      match /comments/{commentId} {
        allow get, list: if hasCommunityPermission('community.read')
          && resource.data.status == 'visible'
          && get(/databases/$(database)/documents/communityPosts/$(postId)).data.status == 'active'
          && get(/databases/$(database)/documents/communityPosts/$(postId)).data.moderationStatus == 'visible'
          && communityPublicationIsActive(
            get(/databases/$(database)/documents/communityPosts/$(postId)).data.communityPublicationId
          );
        allow create, update, delete: if false;
      }

      match /{privateCommunityPostDocument=**} {
        allow read, write: if false;
      }
    }

    match /communityCommandReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /cartularyExports/{exportId} {
      allow get: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && resource.data.status == 'ready'
        && hasPermission(resource.data.organizationId, 'cartulary.export')
        && registryIsInScope(resource.data.organizationId, resource.data.registryId);
      allow list, create, update, delete: if false;

      match /records/{recordId} {
        allow get, list: if signedIn()
          && get(/databases/$(database)/documents/cartularyExports/$(exportId)).data.ownerUid == request.auth.uid
          && get(/databases/$(database)/documents/cartularyExports/$(exportId)).data.status == 'ready'
          && hasPermission(
            get(/databases/$(database)/documents/cartularyExports/$(exportId)).data.organizationId,
            'cartulary.export'
          )
          && registryIsInScope(
            get(/databases/$(database)/documents/cartularyExports/$(exportId)).data.organizationId,
            get(/databases/$(database)/documents/cartularyExports/$(exportId)).data.registryId
          );
        allow create, update, delete: if false;
      }

      match /{privateExportDocument=**} {
        allow read, write: if false;
      }
    }

    match /integrityBatches/{batchId} {
      allow get: if signedIn() && request.auth.uid in resource.data.readerUids;
      allow list, create, update, delete: if false;

      match /receipts/{receiptId} {
        allow get, list: if signedIn()
          && request.auth.uid in get(
            /databases/$(database)/documents/integrityBatches/$(batchId)
          ).data.readerUids;
        allow create, update, delete: if false;
      }

      match /timestampReceipts/{receiptId} {
        allow get, list: if signedIn()
          && request.auth.uid in get(
            /databases/$(database)/documents/integrityBatches/$(batchId)
          ).data.readerUids;
        allow create, update, delete: if false;
      }

      match /publicAnchors/{providerId} {
        allow get, list: if signedIn()
          && request.auth.uid in get(
            /databases/$(database)/documents/integrityBatches/$(batchId)
          ).data.readerUids;
        allow create, update, delete: if false;
      }

      match /{privateBatchDocument=**} {
        allow read, write: if false;
      }
    }

    match /integrityProjections/{cartularyId} {
      allow get: if canReadCartulary(
        get(/databases/$(database)/documents/cartularies/$(cartularyId)).data.organizationId,
        get(/databases/$(database)/documents/cartularies/$(cartularyId)).data.registryId,
        cartularyId
      );
      allow list, create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
