rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function accountIsActive(uid) {
      return signedIn()
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.status == 'active';
    }

    function membershipPath(organizationId) {
      return /databases/$(database)/documents/organizations/$(organizationId)/memberships/$(request.auth.uid);
    }

    function hasActiveMembership(organizationId) {
      return signedIn()
        && exists(membershipPath(organizationId))
        && get(membershipPath(organizationId)).data.status == 'active'
        && get(membershipPath(organizationId)).data.uid == request.auth.uid;
    }

    function hasPermission(organizationId, permission) {
      return hasActiveMembership(organizationId)
        && permission in get(membershipPath(organizationId)).data.permissions;
    }

    function registryIsInScope(organizationId, registryId) {
      return hasActiveMembership(organizationId)
        && registryId in get(membershipPath(organizationId)).data.scopes.registryIds;
    }

    function canReadRegistry(organizationId, registryId) {
      return hasPermission(organizationId, 'registry.read')
        && registryIsInScope(organizationId, registryId);
    }

    function canReadCartulary(organizationId, registryId) {
      return hasPermission(organizationId, 'cartulary.read')
        && registryIsInScope(organizationId, registryId);
    }

    function communityMembershipPath() {
      return /databases/$(database)/documents/communityMemberships/$(request.auth.uid);
    }

    function hasCommunityPermission(permission) {
      return signedIn()
        && exists(communityMembershipPath())
        && get(communityMembershipPath()).data.uid == request.auth.uid
        && get(communityMembershipPath()).data.status == 'active'
        && permission in get(communityMembershipPath()).data.permissions;
    }

    function communityPublicationIsActive(publicationId) {
      return exists(/databases/$(database)/documents/communityPublications/$(publicationId))
        && get(/databases/$(database)/documents/communityPublications/$(publicationId)).data.status == 'published'
        && get(/databases/$(database)/documents/communityPublications/$(publicationId)).data.moderationStatus == 'approved';
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn()
        && request.auth.uid == uid
        && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt', 'updatedAt'])
        && request.resource.data.lastActiveAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow list, create, delete: if false;

      match /private/{privateDocument} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list, create, update, delete: if false;
      }
    }

    match /organizations/{organizationId} {
      allow get: if hasPermission(organizationId, 'organization.read');
      allow list, create, update, delete: if false;

      match /memberships/{uid} {
        allow get: if signedIn()
          && (request.auth.uid == uid || hasPermission(organizationId, 'membership.read'));
        allow list: if hasPermission(organizationId, 'membership.read');
        allow create, update, delete: if false;
      }
    }

    // Autorise uniquement une requête collectionGroup explicitement bornée au uid courant.
    match /{membershipPath=**}/memberships/{membershipId} {
      allow get, list: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /registries/{registryId} {
      allow get: if canReadRegistry(resource.data.organizationId, registryId);
      allow list, create, update, delete: if false;

      match /items/{cartularyId} {
        allow get, list: if canReadRegistry(
          get(/databases/$(database)/documents/registries/$(registryId)).data.organizationId,
          registryId
        );
        allow create, update, delete: if false;
      }

      match /accesses/{accessId} {
        allow get, list: if canReadRegistry(
          get(/databases/$(database)/documents/registries/$(registryId)).data.organizationId,
          registryId
        ) && hasPermission(
          get(/databases/$(database)/documents/registries/$(registryId)).data.organizationId,
          'access.read'
        );
        allow create, update, delete: if false;
      }
    }

    match /schemaCatalog/{assetType} {
      allow get, list: if signedIn();
      allow create, update, delete: if false;

      match /{schemaDocument=**} {
        allow get, list: if signedIn();
        allow create, update, delete: if false;
      }
    }

    match /cartularies/{cartularyId} {
      allow get: if canReadCartulary(resource.data.organizationId, resource.data.registryId);
      allow list, create, update, delete: if false;

      match /{cartularyDocument=**} {
        allow get, list: if canReadCartulary(
          get(/databases/$(database)/documents/cartularies/$(cartularyId)).data.organizationId,
          get(/databases/$(database)/documents/cartularies/$(cartularyId)).data.registryId
        );
        allow create, update, delete: if false;
      }
    }

    // Copie privée de synchronisation du prototype. Elle appartient au compte,
    // reste séparée du Cartulaire autoritaire et ne peut alimenter aucune publication.
    match /privateDrafts/{uid} {
      allow read, write: if false;

      match /cartularies/{cartularyId} {
        allow get, list: if accountIsActive(uid);
        allow create: if accountIsActive(uid)
          && request.resource.data.ownerUid == uid
          && request.resource.data.cartularyId == cartularyId
          && request.resource.data.status == 'active'
          && request.resource.data.retentionPolicyVersion == 'inactive-plus-2y-v1';
        allow update: if accountIsActive(uid)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.ownerUid == uid
          && request.resource.data.cartularyId == resource.data.cartularyId
          && request.resource.data.cartularyId == cartularyId
          && request.resource.data.retentionPolicyVersion == 'inactive-plus-2y-v1'
          && (
            (resource.data.status == 'active' && request.resource.data.status in ['active', 'deleted'])
            || (resource.data.status == 'deleted' && request.resource.data.status == 'deleted')
          );
        allow delete: if signedIn() && request.auth.uid == uid && resource.data.ownerUid == uid;

        match /state/{stateKey} {
          allow get, list: if accountIsActive(uid)
            && get(/databases/$(database)/documents/privateDrafts/$(uid)/cartularies/$(cartularyId)).data.status == 'active';
          allow create, update: if accountIsActive(uid)
            && get(/databases/$(database)/documents/privateDrafts/$(uid)/cartularies/$(cartularyId)).data.status == 'active'
            && request.resource.data.keys().hasOnly([
              'ownerUid', 'cartularyId', 'key', 'value', 'deleted', 'revision',
              'clientUpdatedAt', 'updatedAt'
            ])
            && request.resource.data.ownerUid == uid
            && request.resource.data.cartularyId == cartularyId
            && request.resource.data.key == stateKey
            && stateKey.matches('^cartularia-[A-Za-z0-9:_-]+$')
            && request.resource.data.revision is int
            && request.resource.data.revision > 0
            && request.resource.data.clientUpdatedAt is number
            && request.resource.data.deleted is bool
            && (
              (request.resource.data.deleted == true && request.resource.data.value == null)
              || (
                request.resource.data.deleted == false
                && request.resource.data.value is string
                && request.resource.data.value.size() <= 900000
              )
            );
          allow delete: if signedIn() && request.auth.uid == uid;
        }

        match /binaries/{binaryId} {
          allow get, list: if accountIsActive(uid)
            && get(/databases/$(database)/documents/privateDrafts/$(uid)/cartularies/$(cartularyId)).data.status == 'active';
          allow create, update: if accountIsActive(uid)
            && get(/databases/$(database)/documents/privateDrafts/$(uid)/cartularies/$(cartularyId)).data.status == 'active'
            && request.resource.data.keys().hasOnly([
              'ownerUid', 'cartularyId', 'binaryId', 'deleted', 'revision', 'fileName',
              'mimeType', 'size', 'sha256', 'kind', 'storagePath', 'clientUpdatedAt',
              'uploadStatus', 'updatedAt'
            ])
            && request.resource.data.ownerUid == uid
            && request.resource.data.cartularyId == cartularyId
            && request.resource.data.binaryId == binaryId
            && request.resource.data.revision is int
            && request.resource.data.revision > 0
            && request.resource.data.clientUpdatedAt is number
            && request.resource.data.size is int
            && request.resource.data.size >= 0
            && request.resource.data.sha256.matches('^sha256:[a-f0-9]{64}$')
            && request.resource.data.kind in ['media', 'owner_document', 'condition_attachment']
            && (
              (
                request.resource.data.deleted == true
                && request.resource.data.storagePath == null
                && request.resource.data.uploadStatus == 'deleted'
              )
              || (
                request.resource.data.deleted == false
                && request.resource.data.storagePath is string
                && request.resource.data.uploadStatus == 'ready'
              )
            );
          allow delete: if signedIn() && request.auth.uid == uid;
        }
      }
    }

    // File d'intention minimale. Le navigateur ne peut modifier ni le Cartulaire
    // autoritaire ni sa projection : une commande Admin valide et exécute la demande.
    match /cartularySyncRequests/{requestDocumentId} {
      allow get: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create, update: if accountIsActive(request.auth.uid)
        && request.resource.data.keys().hasOnly([
          'requestDocumentId', 'requestId', 'ownerUid', 'cartularyId', 'reason',
          'status', 'requestedAt', 'updatedAt'
        ])
        && request.resource.data.requestDocumentId == requestDocumentId
        && request.resource.data.cartularyId == requestDocumentId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.requestId is string
        && request.resource.data.requestId.matches('^sync_[a-z0-9_]{16,96}$')
        && request.resource.data.reason in ['private_draft_synchronized', 'manual_retry']
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/cartularies/$(requestDocumentId))
        && get(/databases/$(database)/documents/cartularies/$(requestDocumentId)).data.accountHolderId == request.auth.uid
        && hasPermission(
          get(/databases/$(database)/documents/cartularies/$(requestDocumentId)).data.organizationId,
          'cartulary.edit'
        )
        && registryIsInScope(
          get(/databases/$(database)/documents/cartularies/$(requestDocumentId)).data.organizationId,
          get(/databases/$(database)/documents/cartularies/$(requestDocumentId)).data.registryId
        );
      allow list, delete: if false;
    }

    match /publications/{publicCode} {
      allow get: if resource.data.status == 'published';
      allow list, create, update, delete: if false;

      match /blocks/{blockId} {
        allow get, list: if get(
          /databases/$(database)/documents/publications/$(publicCode)
        ).data.status == 'published';
        allow create, update, delete: if false;
      }
    }

    match /seals/{publicCode} {
      allow get: if resource.data.status == 'issued';
      allow list, create, update, delete: if false;
    }

    match /communityMemberships/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /communityProfiles/{uid} {
      allow get, list: if hasCommunityPermission('community.read')
        && resource.data.status == 'active'
        && resource.data.visibility == 'community';
      allow create, update, delete: if false;

      match /{privateProfileDocument=**} {
        allow read, write: if false;
      }
    }

    match /communityPublications/{publicationId} {
      allow get, list: if hasCommunityPermission('community.read')
        && resource.data.status == 'published'
        && resource.data.moderationStatus == 'approved';
      allow create, update, delete: if false;

      match /blocks/{blockId} {
        allow get, list: if hasCommunityPermission('community.read')
          && communityPublicationIsActive(publicationId);
        allow create, update, delete: if false;
      }

      match /moderationEvents/{eventId} {
        allow get, list: if hasCommunityPermission('community.moderate');
        allow create, update, delete: if false;
      }

      match /{privateCommunityPublicationDocument=**} {
        allow read, write: if false;
      }
    }

    match /communityPosts/{postId} {
      allow get, list: if hasCommunityPermission('community.read')
        && resource.data.status == 'active'
        && resource.data.moderationStatus == 'visible'
        && communityPublicationIsActive(resource.data.communityPublicationId);
      allow create, update, delete: if false;

      match /comments/{commentId} {
        allow get, list: if hasCommunityPermission('community.read')
          && resource.data.status == 'visible'
          && get(/databases/$(database)/documents/communityPosts/$(postId)).data.status == 'active'
          && get(/databases/$(database)/documents/communityPosts/$(postId)).data.moderationStatus == 'visible'
          && communityPublicationIsActive(
            get(/databases/$(database)/documents/communityPosts/$(postId)).data.communityPublicationId
          );
        allow create, update, delete: if false;
      }

      match /{privateCommunityPostDocument=**} {
        allow read, write: if false;
      }
    }

    match /communityCommandReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /cartularyExports/{exportId} {
      allow get: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && resource.data.status == 'ready'
        && hasPermission(resource.data.organizationId, 'cartulary.export')
        && registryIsInScope(resource.data.organizationId, resource.data.registryId);
      allow list, create, update, delete: if false;

      match /records/{recordId} {
        allow get, list: if signedIn()
          && get(/databases/$(database)/documents/cartularyExports/$(exportId)).data.ownerUid == request.auth.uid
          && get(/databases/$(database)/documents/cartularyExports/$(exportId)).data.status == 'ready'
          && hasPermission(
            get(/databases/$(database)/documents/cartularyExports/$(exportId)).data.organizationId,
            'cartulary.export'
          )
          && registryIsInScope(
            get(/databases/$(database)/documents/cartularyExports/$(exportId)).data.organizationId,
            get(/databases/$(database)/documents/cartularyExports/$(exportId)).data.registryId
          );
        allow create, update, delete: if false;
      }

      match /{privateExportDocument=**} {
        allow read, write: if false;
      }
    }

    match /integrityBatches/{batchId} {
      allow get: if signedIn() && request.auth.uid in resource.data.readerUids;
      allow list, create, update, delete: if false;

      match /receipts/{receiptId} {
        allow get: if signedIn() && resource.data.ownerUid == request.auth.uid;
        allow list, create, update, delete: if false;
      }

      match /timestampReceipts/{receiptId} {
        allow get: if signedIn()
          && request.auth.uid in get(
            /databases/$(database)/documents/integrityBatches/$(batchId)
          ).data.readerUids;
        allow list, create, update, delete: if false;
      }

      match /{privateBatchDocument=**} {
        allow read, write: if false;
      }
    }

    match /integrityProjections/{cartularyId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
