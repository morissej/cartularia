rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsAccount(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function baseIsValid(uid, code) {
      return request.resource.data.ownerUid == uid
        && request.resource.data.code == code
        && request.resource.data.schemaVersion == 'code-correspondence@1.0.0';
    }

    function simpleCodeIsValid(uid, code) {
      return request.resource.data.keys().hasOnly(['schemaVersion', 'ownerUid', 'code', 'updatedAt'])
        && baseIsValid(uid, code)
        && code.matches('^(TRN|LIE|GES)-[A-F0-9]{8}$');
    }

    function labeledCodeIsValid(uid, code, codePattern, labelPattern) {
      return request.resource.data.keys().hasOnly(['schemaVersion', 'ownerUid', 'code', 'genericLabel', 'updatedAt'])
        && baseIsValid(uid, code)
        && code.matches(codePattern)
        && request.resource.data.genericLabel is string
        && request.resource.data.genericLabel.matches(labelPattern);
    }

    match /codeAccounts/{uid} {
      allow read, write: if false;

      match /account/{documentId} {
        allow read: if documentId == 'profile' && ownsAccount(uid);
        allow create, update: if documentId == 'profile'
          && ownsAccount(uid)
          && request.resource.data.keys().hasOnly(['schemaVersion', 'ownerUid', 'primaryClientNumber', 'updatedAt'])
          && request.resource.data.schemaVersion == 'code-account-link@1.0.0'
          && request.resource.data.ownerUid == uid
          && request.resource.data.primaryClientNumber.matches('^CLI-[A-F0-9]{8}$');
        allow delete: if documentId == 'profile' && ownsAccount(uid) && resource.data.ownerUid == uid;
      }

      match /clients/{clientNumber} {
        allow read: if ownsAccount(uid);
        allow create: if ownsAccount(uid)
          && request.resource.data.keys().hasOnly(['schemaVersion', 'ownerUid', 'code', 'objectCodes', 'updatedAt'])
          && baseIsValid(uid, clientNumber)
          && clientNumber.matches('^CLI-[A-F0-9]{8}$')
          && request.resource.data.objectCodes is list
          && request.resource.data.objectCodes.size() == 0;
        allow update: if ownsAccount(uid)
          && request.resource.data.keys().hasOnly(['schemaVersion', 'ownerUid', 'code', 'objectCodes', 'updatedAt'])
          && baseIsValid(uid, clientNumber)
          && request.resource.data.objectCodes == resource.data.objectCodes;
        allow delete: if false;
      }

      match /transmissions/{code} {
        allow read: if ownsAccount(uid);
        allow create, update: if ownsAccount(uid) && simpleCodeIsValid(uid, code) && code.matches('^TRN-[A-F0-9]{8}$');
        allow delete: if ownsAccount(uid) && resource.data.ownerUid == uid;
      }

      match /locations/{code} {
        allow read: if ownsAccount(uid);
        allow create, update: if ownsAccount(uid) && labeledCodeIsValid(uid, code, '^LIE-[A-F0-9]{8}$', '^Lieu [1-9][0-9]*$');
        allow delete: if ownsAccount(uid) && resource.data.ownerUid == uid;
      }

      match /managers/{code} {
        allow read: if ownsAccount(uid);
        allow create, update: if ownsAccount(uid) && simpleCodeIsValid(uid, code) && code.matches('^GES-[A-F0-9]{8}$');
        allow delete: if ownsAccount(uid) && resource.data.ownerUid == uid;
      }


      match /people/{code} {
        allow read: if ownsAccount(uid);
        allow create, update: if ownsAccount(uid) && labeledCodeIsValid(uid, code, '^(CLI|PER|GES)-[A-F0-9]{8}$', '^Personne [1-9][0-9]*$');
        allow delete: if ownsAccount(uid) && resource.data.ownerUid == uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
